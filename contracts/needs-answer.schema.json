{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:49gaion:library:tom:needs-answer:v0.6",
  "title": "[ORG]AIOC-TOM needs answer v0.6",
  "description": "The answer of the Chief of Staff of [ORG]AIOC-SL to one needs request: the output of the needs-request sub-item. Admitted only by reference. 'dont know' is an answer and carries the reference of the recorded answer; every outcome other than 'answered' carries a reason. Never a person's name: the answering contributor is a pseudonymous reference. Dates are checked by the validator with format assertion on.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "request_version",
    "request_type",
    "outcome",
    "answered_at"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "pattern": "^NR-[A-Za-z0-9-]+$"
    },
    "request_version": {
      "type": "integer",
      "minimum": 1
    },
    "request_type": {
      "enum": [
        "document",
        "explainer",
        "confirmation",
        "status",
        "export",
        "decision"
      ]
    },
    "outcome": {
      "enum": [
        "answered",
        "declared absent",
        "not applicable",
        "declined",
        "dont know",
        "returned"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "urn:49gaion:library:tom:source-reference:v0.3"
      }
    },
    "answered_by": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contributor_ref"
      ],
      "properties": {
        "contributor_ref": {
          "type": "string",
          "pattern": "^CONTRIB-[A-Za-z0-9-]+$",
          "description": "Pseudonymous Source Lifecycle contributor reference; never a name."
        },
        "cell": {
          "type": "string",
          "pattern": "^(\\[ORG\\]|[0-9A-Za-z]+)CELL-[A-Z0-9]{2,8}$",
          "description": "Required on every decision answer. Source Lifecycle and TEST-TOM case 35 compare it with the request's answering_cell; for a non-delegable row any other Cell is refused."
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deciding_cell",
        "taken",
        "recorded",
        "value"
      ],
      "properties": {
        "deciding_cell": {
          "type": "string",
          "pattern": "^(\\[ORG\\]|[0-9A-Za-z]+)CELL-[A-Z0-9]{2,8}$"
        },
        "taken": {
          "type": "string",
          "format": "date"
        },
        "recorded": {
          "type": "string",
          "format": "date"
        },
        "value": {
          "enum": [
            "dont know",
            "ACCEPT",
            "CORRECT",
            "REJECT",
            "ACCEPT WITH CORRECTIONS (before the next stage)",
            "ACCEPT WITH CORRECTIONS (after the next stage)",
            "RETURN FOR REDESIGN",
            "A governs",
            "B governs",
            "both, in different cases",
            "in scope",
            "out of scope",
            "committed",
            "context",
            "SUPPLY",
            "WITHDRAW",
            "REDESIGN",
            "ACCEPT AS KNOWN DEFECT",
            "CLOSE",
            "reading A",
            "reading B",
            "both readings",
            "same role",
            "different roles",
            "other"
          ]
        },
        "comment": {
          "type": "string",
          "minLength": 1
        },
        "correction_text": {
          "type": "string",
          "minLength": 1,
          "description": "The correction in the decider's own wording; a fact in it is admitted as organisation-stated by this decision's reference."
        },
        "priority": {
          "enum": [
            "must",
            "should",
            "could"
          ],
          "description": "On an element row (blueprint Annex H.7): the priority decided with the element; the proposed priority on ACCEPT, the corrected one on CORRECT."
        },
        "listed_type": {
          "enum": [
            "set-purpose-or-values"
          ],
          "description": "A subset of the pinned Standard's signature list (`contracts/PINS.json`); a type this AIOC's decisions can be. Others go under `org_listed_type`."
        },
        "org_listed_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,60}$"
        },
        "signature_ref": {
          "type": "string",
          "pattern": "^SIG-[0-9A-Za-z-]+$",
          "description": "The gateway signature record (Protocol §4.10, item 9)."
        },
        "weak_approval_signal": {
          "type": "boolean",
          "description": "Computed by Source Lifecycle per pass and per part; true means the row is not decided."
        },
        "delegated": {
          "type": "boolean",
          "description": "True when a delegable row was answered by delegation: recorded 'delegated, not decided'."
        }
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "required": [
                  "listed_type"
                ]
              },
              {
                "required": [
                  "org_listed_type"
                ]
              }
            ]
          },
          "then": {
            "required": [
              "signature_ref"
            ]
          }
        },
        {
          "if": {
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "const": "CORRECT"
              }
            }
          },
          "then": {
            "required": [
              "correction_text"
            ]
          }
        }
      ]
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "description": "The result of a confirmation row: confirm keeps the item inferred with its confirmation reference; correct replaces it with the correction, labelled organisation-stated (blueprint Annex B.1).",
      "properties": {
        "value": {
          "enum": [
            "confirm",
            "correct"
          ]
        },
        "correction_text": {
          "type": "string",
          "minLength": 1
        },
        "known_before": {
          "enum": [
            "yes",
            "no",
            "dont know"
          ],
          "description": "For a found-not-said row: whether the organisation already knew it."
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "const": "correct"
              }
            }
          },
          "then": {
            "required": [
              "correction_text"
            ]
          }
        }
      ]
    },
    "status_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approver_cell",
        "decided",
        "value"
      ],
      "properties": {
        "approver_cell": {
          "type": "string",
          "pattern": "^(\\[ORG\\]|[0-9A-Za-z]+)CELL-[A-Z0-9]{2,8}$"
        },
        "decided": {
          "type": "string",
          "format": "date"
        },
        "value": {
          "enum": [
            "in force",
            "draft",
            "superseded"
          ]
        }
      }
    },
    "simplification_note": {
      "type": "string"
    },
    "answered_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "outcome"
        ],
        "properties": {
          "outcome": {
            "enum": [
              "answered",
              "dont know"
            ]
          }
        }
      },
      "then": {
        "required": [
          "sources",
          "answered_by"
        ]
      }
    },
    {
      "if": {
        "required": [
          "outcome"
        ],
        "properties": {
          "outcome": {
            "enum": [
              "declared absent",
              "not applicable",
              "declined",
              "returned"
            ]
          }
        }
      },
      "then": {
        "required": [
          "reason"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "sources"
              ]
            },
            {
              "required": [
                "decision"
              ]
            },
            {
              "required": [
                "status_decision"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "outcome"
        ],
        "properties": {
          "outcome": {
            "const": "dont know"
          }
        }
      },
      "then": {
        "required": [
          "reason"
        ]
      }
    },
    {
      "if": {
        "required": [
          "outcome",
          "request_type"
        ],
        "properties": {
          "outcome": {
            "const": "answered"
          },
          "request_type": {
            "const": "decision"
          }
        }
      },
      "then": {
        "required": [
          "decision"
        ]
      }
    },
    {
      "if": {
        "required": [
          "outcome",
          "request_type"
        ],
        "properties": {
          "outcome": {
            "const": "answered"
          },
          "request_type": {
            "const": "status"
          }
        }
      },
      "then": {
        "required": [
          "status_decision"
        ]
      }
    },
    {
      "if": {
        "required": [
          "request_type"
        ],
        "properties": {
          "request_type": {
            "not": {
              "const": "decision"
            }
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "decision"
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "outcome",
          "request_type"
        ],
        "properties": {
          "outcome": {
            "const": "answered"
          },
          "request_type": {
            "const": "confirmation"
          }
        }
      },
      "then": {
        "required": [
          "confirmation"
        ]
      }
    },
    {
      "if": {
        "required": [
          "request_type"
        ],
        "properties": {
          "request_type": {
            "not": {
              "const": "confirmation"
            }
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "confirmation"
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "decision"
        ]
      },
      "then": {
        "required": [
          "answered_by"
        ],
        "properties": {
          "answered_by": {
            "required": [
              "contributor_ref",
              "cell"
            ]
          }
        }
      }
    }
  ]
}
