{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:49gaion:library:tom:tom-release:v0.6",
  "title": "[ORG]AIOC-TOM TOM Release manifest v0.6",
  "description": "The manifest of one TOM Release (docs/OUTPUT.md §3). release_id is 'TOMR-' + SHA-256 of the canonical manifest body without release_id; the filing reference is kept in a separate filing receipt, so filing never changes the content address. The manifest names every part and every run record by hash, and every Input Pack version with its snapshots (docs/OUTPUT.md §3). Dates are checked by the validator with format assertion on. It states the run depth, the reference-model catalogue read and the patterns used. From v0.6 it names twenty parts, among them the strategy frame, the outside-party journeys, the value case and the current-state activity profile (blueprint Annex H), and each element decision carries its decided priority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "release_id",
    "org_aion",
    "scope",
    "blueprint_version",
    "standard_versions",
    "depth",
    "input_packs",
    "run_records",
    "release_lint",
    "reference_models",
    "parts",
    "decisions",
    "final_status",
    "honesty_ceiling",
    "confidentiality",
    "supersedes",
    "attestation"
  ],
  "allOf": [
    {
      "if": {
        "required": [
          "decisions"
        ],
        "properties": {
          "decisions": {
            "contains": {
              "properties": {
                "decision": {
                  "properties": {
                    "value": {
                      "const": "ACCEPT AS KNOWN DEFECT"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "known_defects"
        ],
        "properties": {
          "known_defects": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "properties": {
    "release_id": {
      "type": "string",
      "pattern": "^TOMR-[a-f0-9]{64}$"
    },
    "org_aion": {
      "type": "string",
      "pattern": "^.+AION$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "shape",
        "committed_entities",
        "slice"
      ],
      "properties": {
        "subject": {
          "enum": [
            "whole organisation",
            "one unit"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "shape": {
          "enum": [
            "single person",
            "single entity",
            "group of entities",
            "group with independent institutions"
          ]
        },
        "committed_entities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "context_entities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "slice": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "designed",
            "not_yet_designed"
          ],
          "properties": {
            "designed": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^CHILD-[A-Za-z0-9-]+$"
              }
            },
            "not_yet_designed": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^CHILD-[A-Za-z0-9-]+$"
              }
            },
            "withdrawn": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^CHILD-[A-Za-z0-9-]+$"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "subject"
            ],
            "properties": {
              "subject": {
                "const": "one unit"
              }
            }
          },
          "then": {
            "required": [
              "unit"
            ]
          }
        }
      ]
    },
    "blueprint_version": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "standard_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "standard",
        "protocol",
        "library"
      ],
      "properties": {
        "standard": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "protocol": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "library": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "depth": {
      "enum": [
        "light",
        "standard",
        "deep"
      ],
      "description": "The run depth (blueprint Annex F), stated by the Requesting Authority in the Design Request (DRQ-01 field 9), or standard."
    },
    "input_packs": {
      "type": "array",
      "minItems": 1,
      "description": "Every version of the Input Pack the run read, from P0, each with its snapshots; and those of any carried release (from_release).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pack_id",
          "version",
          "snapshots"
        ],
        "properties": {
          "pack_id": {
            "type": "string",
            "pattern": "^TOMI-[a-f0-9]{64}$"
          },
          "version": {
            "type": "string",
            "pattern": "^P[0-9]+$"
          },
          "snapshots": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "adapter_id",
                "snapshot_id"
              ],
              "properties": {
                "adapter_id": {
                  "type": "string",
                  "pattern": "^ADP-[A-Z0-9]{2,12}$"
                },
                "snapshot_id": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "from_release": {
            "type": "string",
            "pattern": "^TOMR-[a-f0-9]{64}$",
            "description": "The pack belongs to a carried release."
          }
        }
      }
    },
    "run_records": {
      "type": "array",
      "minItems": 1,
      "description": "Every run record, by kind and hash; none is a part.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "ref",
          "sha256"
        ],
        "properties": {
          "kind": {
            "enum": [
              "run record",
              "read plan",
              "round log",
              "lens record",
              "party register",
              "child package",
              "packaging ledger",
              "packaging record",
              "gate report",
              "pairing table",
              "walk input",
              "blind brief",
              "hop trace",
              "run preview",
              "review record",
              "ruling sheet",
              "lint report",
              "carry-forward record",
              "difference register"
            ]
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "kind": {
                "const": "review record"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "kind": {
                "const": "lint report"
              }
            },
            "required": [
              "kind"
            ]
          }
        }
      ]
    },
    "release_lint": {
      "type": "object",
      "additionalProperties": false,
      "description": "The release lint result (blueprint Annex E.15): the deny-list version and hash, the report's hash, and each exemption by part, rule, count and atom refs, never the word.",
      "required": [
        "deny_list_version",
        "deny_list_sha256",
        "report_sha256",
        "result",
        "exemptions"
      ],
      "properties": {
        "deny_list_version": {
          "type": "string",
          "pattern": "^v[0-9]+$"
        },
        "deny_list_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "report_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "result": {
          "const": "pass"
        },
        "exemptions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "part",
              "rule",
              "count",
              "atom_refs"
            ],
            "properties": {
              "part": {
                "enum": [
                  "design brief",
                  "structure",
                  "blueprint",
                  "rationale and evidence brief",
                  "design ledger",
                  "hand-offs register",
                  "counterparty register",
                  "legal and regulatory perimeter",
                  "deferred-boundary register",
                  "seam findings",
                  "walkthrough report",
                  "quality checks",
                  "decision package",
                  "registers",
                  "trace",
                  "strategy frame",
                  "outside-party journeys",
                  "value case",
                  "current-state activity profile"
                ]
              },
              "rule": {
                "type": "string",
                "pattern": "^A-(word|P[1-4])$"
              },
              "count": {
                "type": "integer",
                "minimum": 1
              },
              "atom_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^ADP-[A-Z0-9]{2,12}:[^@#\\s]+@[^#\\s]+#\\S+$"
                }
              }
            }
          }
        }
      }
    },
    "carries": {
      "type": "array",
      "minItems": 1,
      "description": "The earlier releases this one carries forward (blueprint §5.9, Slices and carry-forward).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "release_id",
          "release_ref",
          "children"
        ],
        "properties": {
          "release_id": {
            "type": "string",
            "pattern": "^TOMR-[a-f0-9]{64}$"
          },
          "release_ref": {
            "$ref": "urn:49gaion:library:tom:source-reference:v0.3"
          },
          "children": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^CHILD-[A-Za-z0-9-]+$"
            }
          }
        }
      }
    },
    "reference_models": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalogue",
        "patterns_used"
      ],
      "description": "The reference-model catalogue the run read, and the patterns its design ledgers cite (blueprint §5.5; Annex B.5). A pattern is a method, never evidence.",
      "properties": {
        "catalogue": {
          "oneOf": [
            {
              "const": "unavailable"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "version",
                "sha256"
              ],
              "properties": {
                "version": {
                  "type": "string",
                  "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          ]
        },
        "patterns_used": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pattern_id",
              "name",
              "children",
              "elements",
              "assumed_elements"
            ],
            "properties": {
              "pattern_id": {
                "type": "string",
                "pattern": "^RMP-[A-Z0-9-]{2,24}$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "children": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^CHILD-[A-Za-z0-9-]+$"
                }
              },
              "elements": {
                "type": "integer",
                "minimum": 1
              },
              "assumed_elements": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "catalogue": {
                "const": "unavailable"
              }
            },
            "required": [
              "catalogue"
            ]
          },
          "then": {
            "properties": {
              "patterns_used": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "parts": {
      "type": "array",
      "minItems": 20,
      "allOf": [
        {
          "contains": {
            "properties": {
              "part": {
                "const": "design brief"
              }
            },
            "required": [
              "part"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "part": {
                "const": "structure"
              }
            },
            "required": [
              "part"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "part": {
                "const": "blueprint"
              }
            },
            "required": [
              "part"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "part": {
                "const": "rationale and evidence brief"
              }
            },
            "required": [
              "part"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "part": {
                "const": "design ledger"
              }
            },
            "required": [
              "part"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "part": {
                "const": "hand-offs register"
              }
            },
            "required": [
              "part"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "part": {
                "const": "counterparty register"
              }
            },
            "required": [
              "part"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "part": {
                "const": "legal and regulatory perimeter"
              }
            },
            "required": [
              "part"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "part": {
                "const": "deferred-boundary register"
              }
            },
            "required": [
              "part"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "part": {
                "const": "seam findings"
              }
            },
            "required": [
              "part"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "part": {
                "const": "role register"
              }
            },
            "required": [
              "part"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "part": {
                "const": "walkthrough report"
              }
            },
            "required": [
              "part"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "part": {
                "const": "quality checks"
              }
            },
            "required": [
              "part"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "part": {
                "const": "decision package"
              }
            },
            "required": [
              "part"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "part": {
                "const": "registers"
              }
            },
            "required": [
              "part"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "part": {
                "const": "trace"
              }
            },
            "required": [
              "part"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "part": {
                "const": "strategy frame"
              }
            },
            "required": [
              "part"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "part": {
                "const": "outside-party journeys"
              }
            },
            "required": [
              "part"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "part": {
                "const": "value case"
              }
            },
            "required": [
              "part"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "part": {
                "const": "current-state activity profile"
              }
            },
            "required": [
              "part"
            ]
          }
        }
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "part",
          "path",
          "sha256",
          "bytes"
        ],
        "properties": {
          "part": {
            "enum": [
              "design brief",
              "structure",
              "blueprint",
              "rationale and evidence brief",
              "design ledger",
              "hand-offs register",
              "counterparty register",
              "legal and regulatory perimeter",
              "deferred-boundary register",
              "seam findings",
              "role register",
              "walkthrough report",
              "quality checks",
              "decision package",
              "registers",
              "trace",
              "strategy frame",
              "outside-party journeys",
              "value case",
              "current-state activity profile"
            ]
          },
          "child": {
            "type": "string",
            "pattern": "^CHILD-[A-Za-z0-9-]+$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "carried_from": {
            "type": "string",
            "pattern": "^TOMR-[a-f0-9]{64}$",
            "description": "For a part carried from an earlier release: that release."
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "part"
              ],
              "properties": {
                "part": {
                  "enum": [
                    "blueprint",
                    "rationale and evidence brief",
                    "design ledger"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "child"
              ]
            }
          }
        ]
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference",
          "subject",
          "decision"
        ],
        "properties": {
          "reference": {
            "$ref": "urn:49gaion:library:tom:source-reference:v0.3"
          },
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "allOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "deciding_cell",
                  "taken",
                  "recorded",
                  "value"
                ],
                "properties": {
                  "deciding_cell": {
                    "type": "string",
                    "pattern": "^(\\[ORG\\]|[0-9A-Za-z]+)CELL-[A-Z0-9]{2,8}$"
                  },
                  "taken": {
                    "type": "string",
                    "format": "date"
                  },
                  "recorded": {
                    "type": "string",
                    "format": "date"
                  },
                  "value": {
                    "enum": [
                      "dont know",
                      "ACCEPT",
                      "CORRECT",
                      "REJECT",
                      "ACCEPT WITH CORRECTIONS (before the next stage)",
                      "ACCEPT WITH CORRECTIONS (after the next stage)",
                      "RETURN FOR REDESIGN",
                      "A governs",
                      "B governs",
                      "both, in different cases",
                      "in scope",
                      "out of scope",
                      "committed",
                      "context",
                      "SUPPLY",
                      "WITHDRAW",
                      "REDESIGN",
                      "ACCEPT AS KNOWN DEFECT",
                      "CLOSE",
                      "reading A",
                      "reading B",
                      "both readings",
                      "same role",
                      "different roles",
                      "other"
                    ]
                  },
                  "comment": {
                    "type": "string",
                    "minLength": 1
                  },
                  "correction_text": {
                    "type": "string",
                    "minLength": 1,
                    "description": "The correction in the decider's own wording; a fact in it is admitted as organisation-stated by this decision's reference."
                  },
                  "priority": {
                    "enum": [
                      "must",
                      "should",
                      "could"
                    ],
                    "description": "The decided priority of an element row (blueprint Annex H.7): proposed by code, kept on ACCEPT, changed only by CORRECT."
                  },
                  "listed_type": {
                    "enum": [
                      "set-purpose-or-values"
                    ],
                    "description": "A subset of the pinned Standard's signature list (`contracts/PINS.json`); a type this AIOC's decisions can be. Others go under `org_listed_type`."
                  },
                  "org_listed_type": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{2,60}$"
                  },
                  "signature_ref": {
                    "type": "string",
                    "pattern": "^SIG-[0-9A-Za-z-]+$",
                    "description": "The gateway signature record (Protocol §4.10, item 9)."
                  },
                  "weak_approval_signal": {
                    "type": "boolean",
                    "description": "Computed by Source Lifecycle per pass and per part; true means the row is not decided."
                  },
                  "delegated": {
                    "type": "boolean",
                    "description": "True when a delegable row was answered by delegation: recorded 'delegated, not decided'."
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "anyOf": [
                        {
                          "required": [
                            "listed_type"
                          ]
                        },
                        {
                          "required": [
                            "org_listed_type"
                          ]
                        }
                      ]
                    },
                    "then": {
                      "required": [
                        "signature_ref"
                      ]
                    }
                  },
                  {
                    "if": {
                      "required": [
                        "value"
                      ],
                      "properties": {
                        "value": {
                          "const": "CORRECT"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "correction_text"
                      ]
                    }
                  }
                ]
              },
              {
                "properties": {
                  "weak_approval_signal": {
                    "const": false
                  },
                  "delegated": {
                    "const": false
                  }
                }
              }
            ]
          }
        }
      }
    },
    "final_status": {
      "enum": [
        "ACCEPT",
        "ACCEPT WITH CORRECTIONS (before the next stage)",
        "ACCEPT WITH CORRECTIONS (after the next stage)"
      ]
    },
    "honesty_ceiling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release",
        "per_entity",
        "present_state",
        "outcome",
        "criteria",
        "pattern_reliance"
      ],
      "properties": {
        "release": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "claim_ref",
            "distribution"
          ],
          "properties": {
            "label": {
              "enum": [
                "source-backed",
                "inferred",
                "organisation-stated",
                "assumed",
                "unknown"
              ]
            },
            "claim_ref": {
              "type": "string",
              "minLength": 1
            },
            "distribution": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source-backed": {
